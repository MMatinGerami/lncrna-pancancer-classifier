manifest {
    name = 'lncrna-pancancer-classifier'
    description = 'Seed-stability benchmark of lncRNA vs protein-coding tissue-of-origin classifiers'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.04'
}

params {
    processed = "${projectDir}/data/processed"
    config = "${projectDir}/configs/default.yaml"
    universes = 'lncRNA,protein_coding'
    models = 'logreg,xgboost,mlp'
    seeds = '42,43,44,45,46'
    toy = false
    outdir = "${projectDir}/results/nextflow"
    python = "uv run --project ${projectDir} --frozen python"
}

process {
    cpus = 2
    memory = 4.GB
    // an out-of-memory kill (exit 137-140) is retried with more memory; anything else stops the run
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries = 2
    // requests above these are clamped, so the same pipeline fits a laptop or a large node
    resourceLimits = [cpus: 10, memory: 18.GB]

    withName: 'BENCHMARK_CPU' {
        publishDir = [path: { "${params.outdir}/runs" }, mode: 'copy']
    }
    withName: 'BENCHMARK_GPU' {
        maxForks = 1
        publishDir = [path: { "${params.outdir}/runs" }, mode: 'copy']
    }
    withName: 'SEED_STABILITY' {
        publishDir = [path: { params.outdir }, mode: 'copy']
    }
}

executor {
    // local runs: leave headroom on a 24 GB laptop
    cpus = 10
    memory = 18.GB
}

profiles {
    test {
        params.toy = true
        params.config = "${projectDir}/configs/toy.yaml"
        params.seeds = '1,2,3'
        params.outdir = "${projectDir}/results/nextflow-test"
        executor.cpus = 4
        executor.memory = 8.GB
        process.resourceLimits = [cpus: 4, memory: 8.GB]
    }
}

// after the profiles, so a profile's outdir applies here too
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/report.html"
}
timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
}
